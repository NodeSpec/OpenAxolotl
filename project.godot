; OpenAxolotl — Godot project configuration
;
; Single-player only, in every phase (REQ-030). This file deliberately declares
; NO networking or multiplayer autoloads, no peer configuration, and no
; network/* settings. The World Static Analysis Gate parses this file and fails
; CI on any such entry.

config_version=5

[application]

config/name="OpenAxolotl"
config/description="A colorful 3D action-platformer where an axolotl regenerates itself and its world."
config/features=PackedStringArray("4.7", "Forward Plus")
run/main_scene="res://ui/main_menu.tscn"

[dotnet]

; Intentionally empty. This project is GDScript only — no C#, no Mono/.NET
; assemblies, no C# build step (see each node's task doc, metadata.config).

[debug]

; Statically typed GDScript is the project policy, so an untyped declaration is
; a hard error. The unsafe_* family stays at warning level rather than error:
; JSON and file parsing legitimately produce Variant at the boundary, and
; forcing zero unsafe casts there buys type guards everywhere for no real safety.
; They remain visible so an unsafe access in ordinary gameplay code still shows up.
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=1

[rendering]

; THE LOOK FOUNDATION (docs/asset-contract.md, "Rendering"). Forward+ is the
; renderer the shared lighting rig (core/rendering/) is built for: sky-lit
; ambient, SDFGI, SSAO, glow, volumetric fog and soft cascaded shadows exist
; only there. The Mobile fallback keeps the game RUNNING on hardware that
; cannot drive Forward+ (an old integrated GPU): it renders the same scenes
; with the unsupported effects silently dropped, never a crash. Compatibility
; (OpenGL) is not a target: the toy look is unreachable on it.
;
; The baseline machine in docs/performance.md (GTX 1650 class at 1080p) drives
; Forward+ with this rig; the perf gate is the tripwire, not this comment.
;
; THESE ARE THE *MEDIUM* VALUES, matching core/rendering/base_environment.tres
; and for the same reason. RenderQuality owns TAA, the shadow atlas size and
; the soft-shadow filter at runtime and sets each one explicitly per level, so
; what is written here only decides what the EDITOR costs — and the editor
; never runs RenderQuality. Left at their HIGH values (TAA on, a 4096 atlas at
; the highest filter) the viewport was strictly more expensive than the game
; it was authoring, which on a 2 GB mobile GPU is the difference between a
; slow editor and a dead one. HIGH restores all three in RenderQuality.apply.
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/use_taa=false
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
textures/default_filters/anisotropic_filtering_level=3
