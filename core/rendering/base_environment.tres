[gd_resource type="Environment" load_steps=3 format=3]

; THE SHARED ENVIRONMENT — the one look every world is lit with.
;
; Worlds ship GEOMETRY; the game client ships the LOOK. This resource is the
; whole of it: a procedural sky the ambient and reflections are read from, AgX
; tonemapping so saturated albedo never clips to white, screen-space ambient
; occlusion for contact shading, SDFGI so light bounces off the ground onto
; the underside of the axolotl, a soft glow that only the brightest highlights
; reach, a haze with aerial perspective, and a thin volumetric fog that turns
; the sun into visible shafts.
;
; THE HAZE WAS RETUNED WHEN CORAL COVE BECAME A FOREST VALLEY, and the reason
; is worth keeping: it was a dense teal, which is what an underwater scene
; wants — but every scene in this game is ABOVE water, and the underwater
; feel belongs to the water volumes, which tint it themselves. At the old
; density anything past about thirty metres flattened into one teal plane, so
; a valley full of trees read as an empty sea. It is now a thin grey-green
; air haze: distance still recedes, and what is out there is still there.
;
; Every number here is tuned for the art direction in docs/asset-contract.md
; ("Style and art direction"): toy-like materials, readable value contrast, no
; effect loud enough to notice on its own. Exposure sits below 1 and
; saturation above it because AgX, left
; alone, pushes a sunlit pastel toward white: six variants were rendered side
; by side and this is the one where the axolotl's pink survived the sun.
;
; Forward+ only for the expensive half (SDFGI, SSAO, volumetric fog); the
; Mobile fallback renderer drops those silently and keeps the rest. Nothing
; in gameplay reads this resource, so a world may override it with its own
; WorldEnvironment for a mood without touching the client.

[sub_resource type="ProceduralSkyMaterial" id="ProceduralSkyMaterial_lagoon"]
sky_top_color = Color(0.29, 0.5, 0.76, 1)
sky_horizon_color = Color(0.77, 0.86, 0.87, 1)
sky_curve = 0.12
ground_bottom_color = Color(0.11, 0.17, 0.12, 1)
ground_horizon_color = Color(0.44, 0.56, 0.46, 1)
sun_angle_max = 20.0
sun_curve = 0.2

[sub_resource type="Sky" id="Sky_lagoon"]
sky_material = SubResource("ProceduralSkyMaterial_lagoon")

