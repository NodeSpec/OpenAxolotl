[gd_resource type="StandardMaterial3D" format=3]

; HERO GILLS AND FINS — the deep-pink parts: gill stalks and fronds, the
; dorsal fin and the tail tip. These are thin and let light through, which is
; the single most "axolotl" thing the look can do: strong subsurface
; scattering plus backlight, so a gill between the sun and the camera glows
; from behind, and a rim so the fronds separate from the body they overlap.

[resource]
vertex_color_use_as_albedo = true
albedo_color = Color(1, 1, 1, 1)
metallic = 0.0
metallic_specular = 0.4
roughness = 0.5
subsurf_scatter_enabled = true
subsurf_scatter_strength = 0.7
backlight_enabled = true
backlight = Color(0.95, 0.55, 0.62, 1)
rim_enabled = true
rim = 0.5
rim_tint = 0.3
