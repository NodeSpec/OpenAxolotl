// THE SHARED TERRAIN SURFACE — what a platform is made of.
//
// Every platform, wall and gate in every world was a StandardMaterial3D with
// one flat albedo_color. Flat colour is exactly what reads as greybox: a
// surface with no variation across it has no scale, so a 3 m pillar and a
// 12 m terrace look like the same object at different distances, and a
// player cannot judge either.
//
// This is the fix, and it is deliberately NOT an image texture:
//
//   * TRIPLANAR AND WORLD-SPACE. The pattern is sampled from world position
//     on all three axes and blended by the surface normal, so nothing needs
//     UVs. That matters because the platforms are BoxMesh primitives and the
//     props are generated in Blender with no UV layout at all — a texture
//     path would mean unwrapping every one of them and keeping the unwrap in
//     step with a generator that changes.
//   * CONTINUOUS ACROSS SEAMS. Two boxes butted together sample the same
//     world-space field, so the grain runs across the join instead of
//     restarting at it. That is the thing a tiled texture cannot do without
//     an atlas.
//   * NO BINARIES. The whole material family is this file plus a handful of
//     uniform values, which means it can be reviewed in a diff, retuned
//     without a re-bake, and regenerated by anyone.
//
// The pattern itself is three octaves of value noise plus a stratum term.
// The strata are what make it read as GROUND rather than as static: rock and
// earth are laid down in horizontal beds, so a horizontal banding term at a
// tuned scale is most of the cue, and the noise only has to break the bands
// up. `strata_strength` at zero turns a stone into a sand.
//
// Lit, unlike the water: a platform is a surface the player stands on and it
// has to take the rig's key light, or nothing on it casts or reads as solid.

shader_type spatial;
render_mode cull_back, diffuse_burley, specular_schlick_ggx;

// The two ends of the surface's colour range. The pattern chooses between
// them, so a material is defined by a pair rather than by one albedo — which
// is also why every platform now has visible relief at a glance.
uniform vec3 low_tint: source_color = vec3(0.30, 0.27, 0.22);
uniform vec3 high_tint: source_color = vec3(0.55, 0.50, 0.40);

// A third colour applied to UPWARD faces only, mixed in by `top_weight`.
// This is what puts moss on the top of a rock and leaves its sides bare, and
// it costs one dot product.
uniform vec3 top_tint: source_color = vec3(0.30, 0.42, 0.24);
uniform float top_weight: hint_range(0.0, 1.0) = 0.0;
uniform float top_sharpness: hint_range(1.0, 16.0) = 4.0;

// Metres per pattern cell. Bigger numbers give a coarser surface; this is
// the dial that sets apparent scale, so it is the first one to reach for
// when a platform reads as the wrong size.
uniform float grain_scale: hint_range(0.05, 8.0) = 1.6;
uniform float strata_scale: hint_range(0.05, 8.0) = 2.4;
uniform float strata_strength: hint_range(0.0, 1.0) = 0.45;

uniform float roughness_value: hint_range(0.0, 1.0) = 0.85;
uniform float specular_value: hint_range(0.0, 1.0) = 0.2;

varying vec3 world_position;
varying vec3 world_normal;

// Hash and value noise. Written out rather than sampled from a NoiseTexture
// so the material is self-contained: a .tres carrying only uniform values
// can be read and reviewed without opening a second resource.
float hash(vec3 p) {
	return fract(sin(dot(p, vec3(12.9898, 78.233, 37.719))) * 43758.5453);
}

float value_noise(vec3 p) {
	vec3 i = floor(p);
	vec3 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	float n000 = hash(i + vec3(0.0, 0.0, 0.0));
	float n100 = hash(i + vec3(1.0, 0.0, 0.0));
	float n010 = hash(i + vec3(0.0, 1.0, 0.0));
	float n110 = hash(i + vec3(1.0, 1.0, 0.0));
	float n001 = hash(i + vec3(0.0, 0.0, 1.0));
	float n101 = hash(i + vec3(1.0, 0.0, 1.0));
	float n011 = hash(i + vec3(0.0, 1.0, 1.0));
	float n111 = hash(i + vec3(1.0, 1.0, 1.0));
	return mix(
		mix(mix(n000, n100, f.x), mix(n010, n110, f.x), f.y),
		mix(mix(n001, n101, f.x), mix(n011, n111, f.x), f.y),
		f.z);
}

float fbm(vec3 p) {
	return value_noise(p) * 0.55
		+ value_noise(p * 2.13) * 0.30
		+ value_noise(p * 4.37) * 0.15;
}

void vertex() {
	world_position = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	world_normal = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

void fragment() {
	// Horizontal beds, warped by the noise so they are geology rather than
	// stripes. Without the warp this reads as corduroy at any scale.
	float warp = fbm(world_position * (grain_scale * 0.5)) - 0.5;
	float bands = sin(world_position.y * strata_scale + warp * 2.6) * 0.5 + 0.5;

	float grain = fbm(world_position * grain_scale);
	float pattern = mix(grain, mix(grain, bands, 0.75), strata_strength);
	pattern = clamp(pattern, 0.0, 1.0);

	vec3 base = mix(low_tint, high_tint, pattern);

	// Upward faces take the third colour. `pattern` weights it too, so the
	// moss line is ragged instead of a clean horizontal cut.
	float up = pow(clamp(world_normal.y, 0.0, 1.0), top_sharpness);
	base = mix(base, top_tint, up * top_weight * (0.55 + pattern * 0.45));

	ALBEDO = base;
	// Rougher where the pattern is dark: a recess holds dirt and a raised
	// face is worn smooth, and tying the two together is most of what stops
	// a procedural surface reading as painted-on.
	ROUGHNESS = clamp(roughness_value + (0.5 - pattern) * 0.18, 0.0, 1.0);
	SPECULAR = specular_value;
}
