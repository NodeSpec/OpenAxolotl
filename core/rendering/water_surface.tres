[gd_resource type="ShaderMaterial" load_steps=2 format=3]

; THE SHARED WATER SURFACE — the material every WaterVolume's mesh wears.
;
; One material for all water, owned by the client like the rest of the look:
; worlds reference this resource instead of carrying their own tint, so the
; body of water in the greybox, Coral Cove and Bubble Bay is visibly the same
; water. The behaviour lives in water_surface.gdshader (an unshaded, animated
; shimmer with fresnel transparency — see the rationale there); this file
; only binds the shader so scene references stay stable if the shader is
; ever rewritten.

[ext_resource type="Shader" path="res://core/rendering/water_surface.gdshader" id="1_shader"]

[resource]
render_priority = 0
shader = ExtResource("1_shader")
