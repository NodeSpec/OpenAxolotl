[gd_resource type="StandardMaterial3D" format=3]

; THE SHARED WATER SURFACE — the tint every WaterVolume's mesh wears.
;
; Unshaded on purpose. Water here is a TINT the player looks through, not a
; surface that catches the sun: a lit translucent slab changes colour with the
; sun's angle and the sky, and two stacked faces (the top and the near wall,
; which is what the trailing camera sees) would stack that shading. Taking no
; light keeps the tint identical in every world and under any future mood
; environment. A proper water shader (surface waves, caustics, foam) replaces
; this material in ONE place rather than in every world when it comes.
;
; Worlds reference this resource instead of carrying their own material, so
; the look of water is the client's, the same as every other part of the look.

[resource]
transparency = 1
shading_mode = 0
albedo_color = Color(0.2, 0.52, 0.72, 0.32)
