shape = SubResource("BoxShape3D_80")

; The act's boss beat, and it stands at the ENTRANCE to the seed bed rather
; than anywhere inside it. That is not a staging preference, it is forced by
; this world's restoration economy: seven kelp seeds at one resource each
; against costs overridden to 3 and 4 is exactly seven, with no slack at all,
; and a Dredger reverting a region zeroes its banked resources as well as its
; state. A player who touched this machine after collecting even one seed
; could never reach `restored` again, and the shelf wall would stay shut with
; no way back -- an unwinnable level, reachable by walking into a thing the
; level put in the way. The flown route found it in one pass.
;
; So the fight comes first and the planting comes after: the machine that
; flattened the shelf stands over it, you put it down, and only then do you
; sow. Its area wipe is still live during the fight, which is where the stake
; actually is -- it is the only machine in the level that can spend a life.
;
; A world wanting a Dredger that threatens work already done needs spare
; seeds, and enough of them to re-restore from barren AFTER a reversion --
; fourteen here, not eight. That is a level-economy change, not a placement.
[node name="DredgerSeedBed" type="Area3D" parent="." groups=["enemy"]]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -3.5, 7.0, -110)
metadata/enemy_id = "dredger"
metadata/region_id = "coral_shelf"

[node name="Model" parent="DredgerSeedBed" instance=ExtResource("18_fleet_dredger")]

[node name="Collision" type="CollisionShape3D" parent="DredgerSeedBed"]
shape = SubResource("BoxShape3D_80")


; --- Act 7: the tide race. A Netbot in the current, a Drone on the far shore. -
[node name="NetbotTideRace" type="Area3D" parent="." groups=["enemy"]]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.4, -170.5)
