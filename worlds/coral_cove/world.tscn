[node name="CoralCove" type="Node3D"]

[node name="Scenery" type="Node3D" parent="."]

; === THE VALLEY FLOOR === Scenery, with no collider on purpose. The pit volume sits ABOVE it, so a fall ends as a death at the last checkpoint rather than as a long walk home from the bottom of the valley -- but the player sees what they are falling towards, which is the whole point of putting a forest down there.

[node name="ForestFloor" type="MeshInstance3D" parent="Scenery"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -24, -60)
mesh = SubResource("BoxMesh_0")
surface_material_override/0 = ExtResource("7_surface_forest_earth")

; The valley's sides. Without them the forest floor runs out into haze and the player is standing over an endless plain rather than inside somewhere.

[node name="RidgeWest" type="MeshInstance3D" parent="Scenery"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -96, -6, -60)
mesh = SubResource("BoxMesh_1")
surface_material_override/0 = ExtResource("7_surface_forest_earth")

[node name="RidgeEast" type="MeshInstance3D" parent="Scenery"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 96, -6, -60)
mesh = SubResource("BoxMesh_1")
surface_material_override/0 = ExtResource("7_surface_forest_earth")

; === THE WATERWAY: river under act 1, lagoon in act 2 ===

