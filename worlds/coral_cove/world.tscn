surface_material_override/0 = ExtResource("6_surface_river_sand")

[node name="Collision" type="CollisionShape3D" parent="RiverBed"]
shape = SubResource("BoxShape3D_3")

; Land on BOTH sides of the water. Without it the player sees the edge of the water volume itself -- a transparent slab ending in mid-air -- and a river that ends is not a river. Seven metres of open water separate the banks from the route's platforms, which is twice the jump, so this is scenery the player can look at and never reach.

