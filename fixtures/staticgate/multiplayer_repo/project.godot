; FIXTURE — deliberately forbidden. REQ-030 AC-5.
;
; A project.godot that declares networking settings and a multiplayer autoload.
; Parsed as INI rather than pattern-matched, so neither entry can hide behind
; whitespace or section ordering.

config_version=5

[application]

config/name="Forbidden Fixture"

[autoload]

MultiplayerLobby="*res://core/net_player.gd"

[network]

limits/debugger/max_chars_per_second=2048
remote_fs/page_size=65536
