extends SceneTree
const Capture = preload("res://core/enemies/net_capture.gd")
var passed:=0
var failed:=0
func check(value: bool, label: String) -> void:
	if value:passed+=1;print("PASS ",label)
	else:failed+=1;push_error(label)
func _initialize() -> void: run.call_deferred()
func run() -> void:
	var session:=Capture.new()
	var results: Array[String]=[]
	session.escaped.connect(func(id: String) -> void: results.append("escape:"+id))
	session.captured.connect(func(id: String) -> void: results.append("capture:"+id))
	check(session.begin("net"),"capture begins")
	session.tick(.5);session.tail_whack();session.tick(.5);session.tail_whack();session.tick(.99)
	check(session.active(),"two whacks do not release")
	check(session.tail_whack() and results==["escape:net"],"third whack before 2 seconds escapes")
	check(not session.begin("other"),"grace prevents instant recapture")
	session.tick(1.0);session.begin("late");session.tail_whack();session.tail_whack();session.tick(2.)
	check(not session.tail_whack() and results[-1]=="capture:late","deadline wins at exactly 2 seconds")
	session.tick(20.)
	check(results.size()==2,"timeout fires only once")
	session.tick(1.);session.begin("one");check(not session.begin("two"),"second net cannot restart timer")
	session.tick(-1.);check(is_equal_approx(session.remaining,2.),"negative delta cannot extend deadline")
	session.clear();check(not session.active(),"cleanup cancels timer")
	var world:=Node3D.new();root.add_child(world);current_scene=world
	var spawn:=Marker3D.new();spawn.position=Vector3(4,1,2);spawn.add_to_group("spawn_point");world.add_child(spawn)
	var checkpoint:=Marker3D.new();checkpoint.name="LaterCheckpoint";checkpoint.position=Vector3(7,1,2);checkpoint.add_to_group("checkpoint");world.add_child(checkpoint)
	var body:=AxolotlBody.new();body.add_to_group("player");world.add_child(body);body.initialise();body.set_physics_process(false)
	var enemy:=Area3D.new();enemy.name="CaptureNetbot";enemy.add_to_group("enemy");enemy.set_meta("enemy_id","netbot");enemy.position=Vector3(0,0,-1);world.add_child(enemy)
	var systems:=WorldSystems.new();systems.manifest={"worldId":"capture_test","enemies":[{"enemyId":"netbot"}]};world.add_child(systems);systems.wire();systems.set_physics_process(false);systems._bind_player_strikes()
	var fleet:=systems.get_drift_fleet()
	var input:=body.get_input_system()
	var controller:=body.get_controller()
	controller.physics_step(.01,true,PlayerIntent.none())
	systems._on_enemy_contact(enemy)
	check(systems._net_capture.active() and controller.net_captured,"world contact locks actual player")
	check(input.get_grammar()==MovementGrammar.Grammar.LAND,"underwater escape uses tail-whack bindings")
	controller.physics_step(.1,true,PlayerIntent.new(Vector3.ONE,[MovementGrammar.Verb.SPIN_SPRINT]))
	check(controller.get_velocity()==Vector3.ZERO,"captured player cannot swim or spin away")
	check(systems._net_capture.whacks==0,"spin is not an escape whack")
	for index: int in 3:
		var press:=InputEventKey.new();press.physical_keycode=KEY_F;press.pressed=true;input.handle_event(press)
		controller.physics_step(.4,true,input.poll_intent())
		var release:=InputEventKey.new();release.physical_keycode=KEY_F;release.pressed=false;input.handle_event(release)
		if index<2:systems._net_capture.tick(.4)
	check(not systems._net_capture.active() and not controller.net_captured,"three real input presses escape underwater")
	check(not fleet.is_entangled(),"escape removes original slow")
	check(not fleet.is_defeated(enemy.name),"escape swings do not defeat nearby Netbot")
	check(input.get_grammar()==MovementGrammar.Grammar.WATER,"escape restores water bindings")
	systems._net_capture.tick(1.1);systems._on_enemy_contact(enemy)
	var lives_before:=systems.get_lives().get_lives()
	systems._net_capture.tick(2.)
	check(body.global_position.is_equal_approx(spawn.global_position),"failed escape returns to actual spawn anchor")
	check(not controller.net_captured and not fleet.is_entangled(),"timeout clears lock and slow")
	check(body.velocity==Vector3.ZERO and controller.get_velocity()==Vector3.ZERO,"timeout removes carried momentum")
	check(systems.get_lives().get_lives()==lives_before,"capture reset has no added life penalty")
	systems.activate_checkpoint_node(checkpoint)
	systems._net_capture.tick(1.1);systems._on_enemy_contact(enemy);systems._net_capture.tick(2.)
	check(body.global_position.is_equal_approx(checkpoint.global_position),"capture uses activated checkpoint instead of spawn")
	systems._net_capture.tick(1.1);systems._on_enemy_contact(enemy);systems.release_player_factors()
	check(not controller.net_captured and not systems._net_capture.active(),"world teardown releases captured player")
	world.queue_free();await process_frame
	print("CAPTURE CHECKS: %d passed, %d failed"%[passed,failed]);quit(1 if failed else 0)
